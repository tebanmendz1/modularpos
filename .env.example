# APP_URL: The URL where this applet is hosted.
# Automatically set at runtime.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Required in production to encrypt per-company e-CF provider credentials.
# Generate a long random value and never commit the real secret.
ECF_MASTER_KEY="CHANGE_ME_WITH_A_LONG_RANDOM_SECRET"

# PostgreSQL is mandatory for production deployments (EasyPanel, Docker, etc.).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
DATABASE_SSL="false"
DATABASE_POOL_MAX="10"

# Temporary one-time token used only to import the legacy db_store.json.
# Remove this variable from EasyPanel immediately after a successful import.
MIGRATION_TOKEN="CHANGE_ME_WITH_A_ONE_TIME_RANDOM_TOKEN"
